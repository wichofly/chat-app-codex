{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://thread-api-55l7.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": { "key": "x-thread-proxy-secret" }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-thread-proxy-secret" },
          "args": "$TRUSTED_PROXY_SECRET",
          "env": ["TRUSTED_PROXY_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
