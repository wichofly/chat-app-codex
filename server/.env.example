# Copy to server/.env. Replace credentials and generate a random secret, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chat_app"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3001"
CLIENT_ORIGIN="http://localhost:5173"
PORT=3001
NODE_ENV=development
# Keep 0 for direct local access. Render's configured ingress uses 1.
TRUST_PROXY_HOPS=0
# Hosted Vercel/Render only: set the same private random value on both hosts.
# TRUSTED_PROXY_SECRET="generate-a-random-value-at-least-32-characters"

# OpenRouter
OPENROUTER_API_KEY="replace-with-your-openrouter-key"

# Models (ordered)
# Changing model IDs also requires matching pinned tokenizer/template entries in src/modules/ai/tokenizer.ts.
OPENROUTER_MODEL_1="cohere/north-mini-code:free"
OPENROUTER_MODEL_2="google/gemma-4-26b-a4b-it:free"
OPENROUTER_MODEL_3="nvidia/nemotron-3-nano-30b-a3b:free"

# Per-account application budget and bounded model requests
MAX_GENERATIONS_PER_USER_DAY=15
MAX_USER_MESSAGE_CHARS=6000
MAX_HISTORY_MESSAGES=20
MAX_AI_OUTPUT_TOKENS=1024
# Shared context cap across all configured fallback models; set below the smallest model limit.
AI_MAX_CONTEXT_TOKENS=32768
AI_CONTEXT_SAFETY_MARGIN_TOKENS=1024
AI_FIRST_TOKEN_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=90000
